# Copy to .env and fill in — .env is gitignored, never commit real values.

# Neon pooled connection string (keep the -pooler host and ?sslmode=require).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Long random string — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Optional. Comma-separated origins; defaults to "*" if unset.
# ALLOWED_ORIGINS=https://your-frontend.example.com
